{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:react/recommended",
    "plugin:import/recommended"
  ],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/prop-types": "off",
    "class-methods-use-this": "off",
    "no-unused-expressions": "off",
    "react/jsx-filename-extension": [
      "error",
      {
        "extensions": [
          ".js",
          ".jsx"
        ]
      }
    ],
    // Prevent CommonJS usage
    "import/no-commonjs": "error",
    // Warn about unused variables
    "no-unused-vars": "warn",
    // Prevent console.log in production
    "no-console": "warn"
  },
  "settings": {
    "react": {
      "version": "detect"
    }
  }
}